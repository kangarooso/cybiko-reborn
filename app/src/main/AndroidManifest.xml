<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Light key-press haptics. Normal (install-time) permission; no prompt. -->
  <uses-permission android:name="android.permission.VIBRATE"/>
  <application android:theme="@android:style/Theme.Material.NoActionBar" android:label="Cybiko Reborn" android:usesCleartextTraffic="false">
    <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
  </application>
</manifest>
